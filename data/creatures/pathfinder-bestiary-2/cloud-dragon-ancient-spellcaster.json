  "actions": [
    {
      "category": "defensive",
      "cost": "reaction",
      "description": "<p><strong>Trigger</strong> The dragon is the target of a ranged attack</p>\n<p><strong>Requirements</strong> The dragon is aware of the attack and has a free wing</p>\n<hr />\n<p><strong>Effect</strong> The cloud dragon flexes a wing and creates a billowing cloud of mist. The dragon is treated as if they were Hidden for the purposes of resolving the triggering attack, so normally the attacker must succeed at a @Check[flat|dc:11] to target them. The dragon also gains a +4 circumstance bonus to AC against the triggering attack.</p>",
      "frequency": null,
      "name": "Deflecting Cloud",
      "requirements": "The dragon is aware of the attack and has a free wing",
      "traits": [],
      "trigger": "The dragon is the target of a ranged attack"
    },
    {
      "category": "offensive",
      "cost": "1",
      "description": "<p>The cloud dragon's body becomes vaporous and misty. They gain the effects of Vapor Form, except their fly Speed remains unchanged. The cloud dragon can use this action again to return to physical form.</p>",
      "frequency": null,
      "name": "Cloud Form",
      "requirements": null,
      "traits": [
        "polymorph",
        "primal"
      ],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "2",
      "description": "<p>The dragon breathes a thundercloud that deals @Damage[20d6[electricity]|options:area-damage] damage in a @Template[cone|distance:60] (@Check[reflex|dc:41|basic|options:area-effect] save). This cloud remains in the area for [[/gmr 1d4 #rounds]]{1d4 rounds}, with the effects of Mist. A creature that ends its turn inside of the cloud takes @Damage[10d6[electricity]] damage (@Check[reflex|dc:41|basic] save).</p>\n<p>The cloud dragon can't use Breath Weapon again for [[/gmr 1d4 #Recharge Breath Weapon]]{1d4 rounds}.</p>",
      "frequency": null,
      "name": "Breath Weapon",
      "requirements": null,
      "traits": [
        "electricity",
        "primal"
      ],
      "trigger": null
    },
    {
      "category": "defensive",
      "cost": "passive",
      "description": "",
      "frequency": null,
      "name": "+1 Status to All Saves vs. Magic",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "passive",
      "description": "<p>The cloud dragon can tread on clouds or fog as though on solid ground.</p>",
      "frequency": null,
      "name": "Cloud Walk",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "defensive",
      "cost": "passive",
      "description": "<p>90 feet. @Check[will|dc:40]</p>\n<hr />\n<p><p>A creature that first enters the area must attempt a Will save.</p>\n<p>Regardless of the result of the saving throw, the creature is temporarily immune to this monster's Frightful Presence for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected by the presence.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 4.</p></p>",
      "frequency": null,
      "name": "Frightful Presence",
      "requirements": null,
      "traits": [
