    {
      "category": "defensive",
      "cost": "reaction",
      "description": "<p><strong>Trigger</strong> A creature ends its turn adjacent to the medusa.</p>\n<hr />\n<p><strong>Effect</strong> The medusa makes a snake fangs Strike against the creature.</p>",
      "frequency": null,
      "name": "Biting Snakes",
