    },
    {
      "category": "offensive",
      "cost": "passive",
      "description": "<p>An umbral dragon's Strikes affect incorporeal creatures with the effects of a <em>Ghost Touch</em> property rune, and an umbral dragon's jaws deal an additional @Damage[6d6[force]] damage to undead.</p>",
