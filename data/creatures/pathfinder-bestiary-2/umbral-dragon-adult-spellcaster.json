  "actions": [
    {
      "category": "offensive",
      "cost": "reaction",
      "description": "<p>Jaws only</p>\n<hr />\n<p><p><strong>Trigger</strong> A creature within the monster's reach uses a manipulate action or a move action, makes a ranged attack, or leaves a square during a move action it's using.</p>\n<hr />\n<p><strong>Effect</strong> The monster attempts a melee Strike against the triggering creature. If the attack is a critical hit and the trigger was a manipulate action, the monster disrupts that action. This Strike doesn't count toward the monster's multiple attack penalty, and its multiple attack penalty doesn't apply to this Strike.</p></p>",
      "frequency": null,
      "name": "Attack of Opportunity (Jaws Only)",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "2",
      "description": "<p>The umbral dragon breathes in one of two ways. They can't use Breath Weapon again for [[/gmr 1d4 #Recharge Breath Weapon]]{1d4 rounds}.</p>\n<ul>\n<li><strong>Void</strong> The dragon breathes a blast of darkness in a @Template[cone|distance:40] that deals @Damage[16d6[void]|options:area-damage] damage (@Check[reflex|dc:36|basic|options:area-effect] save). Undead creatures take @Damage[19d6[force]|options:area-damage] damage instead of the void damage.</li>\n<li><p><strong>Shadows</strong> The dragon breathes a blast of shadows in a @Template[cone|distance:40]. Each creature within the cone must attempt a @Check[fortitude|dc:36|options:area-effect] save.</p>\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Enfeebled 2 for 1 round.</p>\n<p><strong>Failure</strong> The creature is Enfeebled 2 for 1 minute.</p>\n<p><strong>Critical Failure</strong> The creature is Enfeebled 2 for 1 minute and Blinded for 1 round.</p>\n</li>\n</ul>",
      "frequency": null,
      "name": "Breath Weapon",
      "requirements": null,
      "traits": [
        "primal",
        "shadow",
        "void"
      ],
      "trigger": null
    },
    {
      "category": "defensive",
      "cost": "passive",
      "description": "",
      "frequency": null,
      "name": "+1 Status to All Saves vs. Magic",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "defensive",
      "cost": "passive",
      "description": "<p>90 feet. @Check[will|dc:34]</p>\n<hr />\n<p><p>A creature that first enters the area must attempt a Will save.</p>\n<p>Regardless of the result of the saving throw, the creature is temporarily immune to this monster's Frightful Presence for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected by the presence.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 4.</p></p>",
      "frequency": null,
