    {
      "category": "defensive",
      "cost": "reaction",
      "description": "<p><strong>Trigger</strong> Darivan takes damage while he's within the Cradle of Lamashtu.</p>\n<p><strong>Effect</strong> Darivan cries out a quick prayer to the Mother of Monsters, and filaments of fungus slither up into his wounded body, healing @Damage[4d6[healing]] points of damage. For the next 4 rounds, Darivan gains regeneration 10; this regeneration can be deactivated by cold iron or spirit damage. Darivan can't activate Bloom Regeneration again for 24 hours.</p>\n<p>Effect: Bloom Regeneration</p>",
      "frequency": null,
      "name": "Bloom Regeneration",
      "requirements": null,
      "traits": [
        "divine"
      ],
      "trigger": "Darivan takes damage while he's within the Cradle of Lamashtu."
    },
    {
      "category": "offensive",
      "cost": "1",
      "description": "<p><strong>Requirement</strong> Darivan hasn't attempted a falchion strike yet.</p>\n<p><strong>Effect</strong> Darivan attempts a Strike with a falchion. On a hit, he inflicts an additional @Damage[2d6[bleed]] damage.</p>",
      "frequency": null,
      "name": "Bleed for Lamashtu",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "passive",
      "description": "<p>When Darivan's bloodline magic activates, his movements become supernaturally graceful and distracting, granting him a +1 status bonus to Diplomacy checks for 1 round or imposing a -1 status penalty on one target's Will saves for 1 round.</p>\n<p>Effect: Darivan's Bloodline Magic</p>",
      "frequency": null,
      "name": "Bloodline Magic",
