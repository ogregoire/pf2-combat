      "trigger": null
    },
    {
      "category": "interaction",
      "cost": "passive",
      "description": "<p>Fog and mist don't impair a cloud dragon's vision; they ignore the Concealed condition from fog and mist.</p>",
      "frequency": null,
      "name": "Mist Vision",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
