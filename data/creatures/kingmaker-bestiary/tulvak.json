      ],
      "trigger": "Tulvak uses Change Shape to assume her natural shape"
    },
    {
      "category": "offensive",
      "cost": "1",
      "description": "<p>The green hag touches a creature that doesn't realize the hag is an enemy. The betrayed creature is affected by the hag's enfeebling humors and takes a -4 circumstance penalty to their saving throw against that effect.</p>",
      "frequency": null,
      "name": "Betraying Touch",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "1",
      "description": "<p>The green hag can take on the appearance of any Medium humanoid woman. This doesn't change her Speed or her attack and damage bonuses with her Strikes, but might change the damage type her Strikes deal (typically to bludgeoning).</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.ChangeShape]</p>",
