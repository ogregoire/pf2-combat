    {
      "category": "offensive",
      "cost": "1",
      "description": "<p><strong>Requirements</strong> Ilora wields two melee weapons, one in each hand</p>\n<p><strong>Effect</strong> Ilora gains a +1 circumstance bonus to AC until the start of her next turn. She loses this bonus if she no longer meets the requirements.</p>\n<p>Effect: Twin Parry</p>",
      "frequency": null,
      "name": "Twin Parry",
      "requirements": "Ilora wields two melee weapons, one in each hand",
      "traits": [],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "passive",
      "description": "<p>Ilora always finds the weak points in her foes' defenses when they're on unfavorable terrain. Enemies are Off-Guard to her if they're in difficult terrain, Restrained, or Immobilized due to natural or magical environmental effects.</p>",
      "frequency": null,
      "name": "Nature's Edge",
