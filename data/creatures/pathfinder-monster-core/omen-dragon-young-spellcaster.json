      "cost": "passive",
      "description": "",
      "frequency": null,
      "name": "+2 Status to All Saves vs. Occult",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "passive",
      "description": "<p>The dragon or any ally can glimpse into the future through the dragon's wings in a process that requires 10 minutes of concentration. This casts a 4th-rank Augury spell, except that the wings can predict results up to 1 day into the future and the dragon always speaks a few cryptic words related to the result of the prediction.</p>\n<p>The dragon can use their wings in this way only once per hour, and a given creature can seek a future in the wings only once per week.</p>",
      "frequency": null,
      "name": "Prophetic Wings",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "defensive",
      "cost": "passive",
      "description": "<p>The dragon can choose to negate any fortune or misfortune effects that would affect them; other creatures remain affected normally.</p>",
      "frequency": null,
      "name": "Untethered to Fate",
      "requirements": null,
      "traits": [],
      "trigger": null
    }
