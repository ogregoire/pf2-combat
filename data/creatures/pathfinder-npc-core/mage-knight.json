    {
      "category": "offensive",
      "cost": "free",
      "description": "<p><strong>Frequency</strong> once per turn</p>\n<p><strong>Requirements</strong> The mage knight's most recent action was to cast a non-cantrip spell</p><hr /><p><strong>Effect</strong> The mage knight siphons spell energy into one weapon they're wielding, or into one of their unarmed attacks. Until the end of the turn, the weapon or unarmed attack deals an extra 2d6 force damage and gains the arcane trait if it didn't have it already. If the spell dealt a different type of damage, the Strike deals this type of damage instead</p>",
      "frequency": {
        "max": 1,
        "per": "turn"
      },
      "name": "Bespell Strikes",
      "requirements": "The mage knight's most recent action was to cast a non-cantrip spell",
      "traits": [],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "1",
      "description": "<p><strong>Frequency</strong> once per day</p>\n<p><strong>Requirements</strong> The mage knight hasn't acted yet on this turn</p><hr /><p><strong>Effect</strong> The mage knight expends the power stored in their bonded item (typically their shield). This gives them the ability to cast one prepared spell they prepared today and already cast, without spending a slot.</p>",
      "frequency": {
        "max": 1,
        "per": "day"
      },
      "name": "Drain Bonded Item",
      "requirements": "The mage knight hasn't acted yet on this turn",
      "traits": [
        "arcane"
      ],
      "trigger": null
    },
    {
      "category": "defensive",
      "cost": "reaction",
      "description": "<p><p><strong>Trigger</strong> The monster has its shield raised and takes damage from a physical attack.</p>\n<hr />\n<p><strong>Effect</strong> The monster snaps its shield into place to deflect a blow. The shield prevents the monster from taking an amount of damage up to the shield's Hardness. The monster and the shield each take any remaining damage, possibly breaking or destroying the shield.</p></p>",
      "frequency": null,
      "name": "Shield Block",
      "requirements": null,
      "traits": [],
      "trigger": "The monster has its shield raised and takes damage from a physical attack."
