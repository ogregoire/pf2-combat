  "actions": [
    {
      "category": "defensive",
      "cost": "reaction",
      "description": "<p><strong>Frequency</strong> once per day</p>\n<p><strong>Trigger</strong> A creature attacks or uses a spell or ability that would affect the eldritch emeritus</p><hr /><p><strong>Effect</strong> A masterpiece of complex spellwork instantly takes shape, casting Fire Shield, Mislead, and Mountain Resilience on the eldritch emeritus, each as an 8th-rank arcane spell.</p>",
      "frequency": {
        "max": 1,
        "per": "day"
      },
      "name": "Third Contingent Sequencer",
      "requirements": null,
      "traits": [],
      "trigger": "A creature attacks or uses a spell or ability that would affect the eldritch emeritus"
    },
    {
      "category": "defensive",
      "cost": "reaction",
      "description": "<p><strong>Trigger</strong> A creature casts a spell the eldritch emeritus has prepared.</p><hr /><p><strong>Effect</strong> The emeritus expends a prepared spell to counter the triggering creature's casting of that same spell. The emeritus loses their spell slot as if they had cast the triggering spell. The emeritus then attempts to counteract the triggering spell.</p>",
      "frequency": null,
      "name": "Counterspell",
      "requirements": null,
      "traits": [],
      "trigger": "A creature casts a spell the eldritch emeritus has prepared."
    },
    {
      "category": "offensive",
      "cost": "1",
      "description": "<p><span class=\"action-glyph\">1</span> to <span class=\"action-glyph\">3</span></p>\n<p><strong>Requirements</strong> The eldritch emeritus has seen a creature Cast a Spell of 7th rank or lower during the previous round, that spell takes between one and three actions to cast, and that spell is on the arcane spell list</p><hr /><p><strong>Effect</strong> The eldritch emeritus mastered that spell 30 years ago, and is happy to show how a real master does it. The emeritus Casts the same Spell but heightened to 8th rank. Didactic Arcanism uses the same number of actions as the original spell took to cast.</p>",
      "frequency": null,
      "name": "Didactic Arcanism",
      "requirements": "The eldritch emeritus has seen a creature Cast a Spell of 7th rank or lower during the previous round, that spell takes between one and three actions to cast, and that spell is on the arcane spell list",
      "traits": [
        "arcane",
        "magical"
      ],
      "trigger": null
    },
    {
      "category": "interaction",
      "cost": "passive",
      "description": "<p><p>A constant spell affects the monster without the monster needing to cast it, and its duration is unlimited. If a constant spell gets counteracted, the monster can reactivate it by spending the normal spellcasting actions the spell requires.</p></p>",
      "frequency": null,
      "name": "Constant Spells",
      "requirements": null,
      "traits": [],
      "trigger": null
    },
    {
      "category": "offensive",
      "cost": "passive",
      "description": "<p>If a reaction would disrupt the eldritch emeritus's spellcasting action, the eldritch emeritus attempts a @Check[flat|dc:15]. On a success, the action isn't disrupted</p>",
      "frequency": null,
      "name": "Steady Spellcasting",
      "requirements": null,
      "traits": [],
      "trigger": null
    }
  ],
