    },
    {
      "category": "defensive",
      "cost": "passive",
      "description": "<p>20 feet. Allies in the planetar's aura gain a +2 status bonus to AC against evil creatures and a +2 status bonus to damage rolls against evil creatures. The area in the aura is difficult terrain for evil creatures.</p>",
      "frequency": null,
      "name": "Aura of Righteousness",
      "requirements": null,
      "traits": [
        "aura",
